# Puerto donde escucha el servidor
PORT=3000
# Carpeta donde se guarda la base de datos SQLite y los archivos subidos
DATA_DIR=./data
# Si se define, hace falta este código para registrarse (recomendado si expones la Pi a internet)
REGISTRATION_CODE=
# Pon "true" si sirves la web por HTTPS (cookies seguras)
COOKIE_SECURE=false
